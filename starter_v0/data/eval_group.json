      "id": "G05_merge_duplicate_news_items",
      "phase": "B",
      "suite": "group",
      "query": "Mình có 3 tin sau, gộp giúp mình các tin trùng nhau thôi, chưa cần làm bản tin:\n1. \"OpenAI ra mắt GPT-5\" - https://www.theverge.com/openai-gpt-5?utm_source=x - The Verge\n2. \"OpenAI ra mắt GPT-5\" - https://theverge.com/openai-gpt-5/ - Google News\n3. \"Google công bố Gemini 3\" - https://blog.google/gemini-3 - Google Blog",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "deduplicate_news",
            "args": {}
          }
        ]
      },
      "metadata": {
        "skill": "dedupe_given_items_routing",
        "difficulty": "medium",
        "what_it_tests": "Người dùng đưa sẵn các tin (2 tin trùng URL sau chuẩn hoá) và chỉ yêu cầu gộp tin trùng → gọi tool mới deduplicate_news, không gọi lookup tìm tin mới và không gọi format."
      }
    },
