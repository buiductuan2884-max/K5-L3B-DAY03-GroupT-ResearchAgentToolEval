      "expect": {
        "tool_calls": [
          {
            "name": "date_localized",
            "args": {
              "timezone": "America/Los_Angeles"
            }
          }
        ]
      },
      "metadata": {
        "skill": "direct_localized_time",
        "difficulty": "easy",
        "what_it_tests": "Hỏi trực tiếp giờ hiện tại tại thành phố → date_localized với timezone IANA; không dùng tra cứu web."
      }
    },
    {
