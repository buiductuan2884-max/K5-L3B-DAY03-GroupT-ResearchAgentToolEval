{
  "dataset_id": "day03_v2_research_group",
  "dataset_role": "group",
  "description": "Case do NHÓM tự viết thêm để cover thêm trường hợp. Mỗi case cần: id, phase='B', query HOẶC turns, failure_type (thuộc allowed_failure_types), và expect (tool_calls[...] hoặc no_tool=true). Nên kèm metadata.what_it_tests.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_wikipedia_knowledge_summary",
      "phase": "B",
      "suite": "group",
      "query": "Ada Lovelace là ai?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "wiki_sum",
            "args": {
              "title": "Ada Lovelace"
            }
          }
        ]
      },
      "metadata": {
        "skill": "wiki_knowledge_baseline",
        "difficulty": "easy",
        "what_it_tests": "Câu hỏi 'X là ai?' về kiến thức nền → wiki_sum, không phải lookup tin tức."
      }
    },
    {
      "id": "G02_validate_shortened_link",
      "phase": "B",
      "suite": "group",
      "query": "Link https://bit.ly/ai-update này có phải link rút gọn và domain có bị chặn không?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "validate_url",
            "args": {
              "url": "https://bit.ly/ai-update"
            }
          }
        ]
      },
      "metadata": {
        "skill": "validate_specific_url",
        "difficulty": "easy",
        "what_it_tests": "Hỏi trực tiếp kiểm tra một URL → validate_url; kết quả cần được diễn giải thận trọng, không khẳng định an toàn tuyệt đối."
      }
    },
    {
